# Copiar las variables necesarias al .env local. No publicar credenciales.
# Los canales solo se activan cuando están conectados y listos para mensajes reales.
COBROS_EMAIL_AUTOMATICO=false
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=alfadigital.sas@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=alfadigital.sas@gmail.com
MAIL_FROM_NAME="Alfa Digital Solutions SAS"

COBROS_WHATSAPP_AUTOMATICO=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Usar una versión vigente y admitida por la aplicación de Meta.
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=recordatorio_mensualidad
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
